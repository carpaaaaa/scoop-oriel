{
    "version": "0.1.22",
    "description": "A free, open source browser for Windows: a column of tabs, spaces, Chrome extensions, ads and trackers blocked, no account. An unofficial port of Search, the browser for the Mac.",
    "homepage": "https://oriel.charstudio.app/",
    "license": "MIT",
    "notes": [
        "Oriel installs for your account with its own installer and updates itself.",
        "It isn't code-signed yet, so Windows may ask before it runs. The installers' SHA-256 are in SHA256SUMS.txt on each release, and Scoop checks them."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/carpaaaaa/oriel/releases/download/v0.1.22/Oriel-Setup-0.1.22-x64.exe#/setup.exe",
            "hash": "71be40afef64c332b702280a5f7e3f08b61c9cdcf4c24a60896434140bfbf87e"
        },
        "arm64": {
            "url": "https://github.com/carpaaaaa/oriel/releases/download/v0.1.22/Oriel-Setup-0.1.22-arm64.exe#/setup.exe",
            "hash": "2e0595411a381a3be7fa1f59870d601e8a4ca94a29a45a2ae6be25c72929b616"
        }
    },
    "installer": {
        "file": "setup.exe",
        "args": [
            "/S",
            "/currentuser"
        ],
        "keep": true
    },
    "uninstaller": {
        "script": [
            "$uninstall = Join-Path $env:LOCALAPPDATA 'Programs\\Oriel\\Uninstall Oriel.exe'",
            "if (Test-Path $uninstall) { Start-Process -FilePath $uninstall -ArgumentList '/S', '/currentuser' -Wait }"
        ]
    },
    "checkver": {
        "github": "https://github.com/carpaaaaa/oriel"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/carpaaaaa/oriel/releases/download/v$version/Oriel-Setup-$version-x64.exe#/setup.exe",
                "hash": {
                    "url": "https://github.com/carpaaaaa/oriel/releases/download/v$version/SHA256SUMS.txt",
                    "regex": "$sha256\\s+Oriel-Setup-$version-x64\\.exe"
                }
            },
            "arm64": {
                "url": "https://github.com/carpaaaaa/oriel/releases/download/v$version/Oriel-Setup-$version-arm64.exe#/setup.exe",
                "hash": {
                    "url": "https://github.com/carpaaaaa/oriel/releases/download/v$version/SHA256SUMS.txt",
                    "regex": "$sha256\\s+Oriel-Setup-$version-arm64\\.exe"
                }
            }
        }
    }
}
